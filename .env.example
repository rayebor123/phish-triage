# Copy to .env and fill in. Make sure .env is in .gitignore before you commit.
# Note: each provider uses a DIFFERENT auth header. Handled in enrich.py.
#   VirusTotal -> x-apikey
#   AbuseIPDB  -> Key
#   urlscan.io -> API-Key

VT_API_KEY=your_virustotal_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
URLSCAN_API_KEY=your_urlscan_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
